<?xml version="1.0"?>
<sdf version="1.6">
    <world name="mundo_simulacion">
        <!-- Si declaramos al menos 1 plugin, debemos manualmente incorporar los plugins básicos para que gazebo funcione! -->
        <!-- Físicas -->
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"> </plugin>
        <!-- SIN ESTO no existe el servicio /world/default/create -->
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"> </plugin>
        <!-- Necesario para que ros_gz_sim pueda hacer broadcast del scene -->
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"> </plugin>
        <!-- Recién ahora podemos hablar de poner un sensor u otro plugin en el SDF! -->

        <physics name="1ms" type="ode">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
            <real_time_update_rate>1000</real_time_update_rate>
        </physics>

        <gravity>0 0 -9.8</gravity>

        <light name="sol" type="directional">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <include>
            <uri>model://Desk</uri>
            <pose>-0.2 0.0 0.0 0 0 0</pose>
        </include>        

        <model name="suelo">
            <static>true</static>
            <link name="suelo_link">
                <collision name="suelo_collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal> <!-- Normal hacia arriba en Z -->
                            <size>50 50</size> <!-- Superficie grande para cubrir el área -->
                        </plane>
                    </geometry>
                    <surface>
                        <contact>
                            <ode>
                                <kp>100000</kp> <!-- Rigidez del contacto -->
                                <kd>1.0</kd>      <!-- Amortiguación del contacto -->
                            </ode>
                        </contact>
                        <friction>
                            <ode>
                                <mu>1.0</mu> <!-- Coeficiente de fricción -->
                                <mu2>1.0</mu2>
                            </ode>
                        </friction>
                    </surface>
                </collision>
                <visual name="suelo_visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>50 50</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.85 0.82 0.78 1</ambient>
                        <diffuse>0.85 0.82 0.78 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ==================================================================
             TRES OBSTACULOS
             Tres pilares apoyados sobre la tapa del escritorio (z=0.552).
             Estan en fila sobre x=-0.22 y separados 0.22 en y, asi que entre
             uno y otro queda un hueco de 0.16 por donde el brazo puede bajar.
             Las alturas son distintas a proposito: el del medio es el mas
             alto (0.28) y obliga a levantar la muneca para cruzar de un hueco
             al otro.
             Son <static>true</static>: no caen ni se acomodan al darle play,
             asi que la escena de planificacion de move_across_desk.py
             coincide exactamente con lo que ve Gazebo.
             ================================================================== -->

        <!-- Pilar alto, al frente del robot. Tope en z = 0.552 + 0.28 = 0.832 -->
        <model name="torre_alta">
            <static>true</static>
            <pose>-0.22 -0.06 0.692 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box><size>0.06 0.06 0.28</size></box>
                    </geometry>
                    <material>
                        <ambient>0.8 0.2 0.2 1</ambient>
                        <diffuse>0.9 0.25 0.25 1</diffuse>
                    </material>
                </visual>
                <collision name="collision">
                    <geometry>
                        <box><size>0.06 0.06 0.28</size></box>
                    </geometry>
                </collision>
            </link>
        </model>

        <!-- Pilar medio, del lado +y. Tope en z = 0.552 + 0.20 = 0.752 -->
        <model name="torre_media">
            <static>true</static>
            <pose>-0.22 0.16 0.652 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box><size>0.06 0.06 0.20</size></box>
                    </geometry>
                    <material>
                        <ambient>0.2 0.5 0.8 1</ambient>
                        <diffuse>0.25 0.6 0.9 1</diffuse>
                    </material>
                </visual>
                <collision name="collision">
                    <geometry>
                        <box><size>0.06 0.06 0.20</size></box>
                    </geometry>
                </collision>
            </link>
        </model>

        <!-- Pilar bajo, del lado -y. Tope en z = 0.552 + 0.12 = 0.672 -->
        <model name="torre_baja">
            <static>true</static>
            <pose>-0.22 -0.28 0.612 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box><size>0.06 0.06 0.12</size></box>
                    </geometry>
                    <material>
                        <ambient>0.9 0.7 0.1 1</ambient>
                        <diffuse>1.0 0.8 0.15 1</diffuse>
                    </material>
                </visual>
                <collision name="collision">
                    <geometry>
                        <box><size>0.06 0.06 0.12</size></box>
                    </geometry>
                </collision>
            </link>
        </model>
    </world>
</sdf>
