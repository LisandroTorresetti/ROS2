      </geometry>
        <origin xyz = "0.005 -0.0195 -0.012 " rpy = " 0 0 0"/>
    </collision>
  </link>

  <link name="gripper_left3">
    <inertial>
      <origin xyz="0.012 0.0025 -0.012" rpy="0 0 0"/>
      <mass value="0.008"/>
      <inertia ixx="0.000002" ixy="0.0" ixz="0.0" iyy="0.000002" iyz="0.0" izz="0.000002"/>
    </inertial>
    <visual>
      <geometry>
      <mesh filename="package://clase5/robot_description/adaptive_gripper/gripper_left3.dae"/>
